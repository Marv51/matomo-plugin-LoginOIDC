# Copy to .env and fill in. .env is git-ignored.

# Domain or issuer URL of your OpenID Connect provider, used for discovery
OIDC_ISSUER="idp.example.com"
OIDC_CLIENT_ID="matomo"
OIDC_CLIENT_SECRET="change-me"

# Optional
OIDC_SCOPE="openid email"
OIDC_BUTTON_NAME="OIDC login"
# Hex color of the login button, empty keeps Matomo's default
OIDC_BUTTON_COLOR=""
# One domain per line, empty allows sign-up for any email domain
OIDC_ALLOWED_SIGNUP_DOMAINS=""

MATOMO_PORT=8080
MATOMO_ADMIN_PASSWORD="matomo-dev-password"
